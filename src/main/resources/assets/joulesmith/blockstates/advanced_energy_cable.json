{
  "multipart": [
    {
      "when": {
        "node": "true"
      },
      "apply": {
        "model": "joulesmith:block/advanced_energy_cable_node"
      }
    },
    {
      "when": {
        "node": "true",
        "north": "true"
      },
      "apply": {
        "model": "joulesmith:block/advanced_energy_cable_arm"
      }
    },
    {
      "when": {
        "node": "false",
        "north": "true"
      },
      "apply": {
        "model": "joulesmith:block/advanced_energy_cable_half"
      }
    },
    {
      "when": {
        "node": "true",
        "east": "true"
      },
      "apply": {
        "model": "joulesmith:block/advanced_energy_cable_arm",
        "y": 90
      }
    },
    {
      "when": {
        "node": "false",
        "east": "true"
      },
      "apply": {
        "model": "joulesmith:block/advanced_energy_cable_half",
        "y": 90
      }
    },
    {
      "when": {
        "node": "true",
        "south": "true"
      },
      "apply": {
        "model": "joulesmith:block/advanced_energy_cable_arm",
        "y": 180
      }
    },
    {
      "when": {
        "node": "false",
        "south": "true"
      },
      "apply": {
        "model": "joulesmith:block/advanced_energy_cable_half",
        "y": 180
      }
    },
    {
      "when": {
        "node": "true",
        "west": "true"
      },
      "apply": {
        "model": "joulesmith:block/advanced_energy_cable_arm",
        "y": 270
      }
    },
    {
      "when": {
        "node": "false",
        "west": "true"
      },
      "apply": {
        "model": "joulesmith:block/advanced_energy_cable_half",
        "y": 270
      }
    },
    {
      "when": {
        "node": "true",
        "up": "true"
      },
      "apply": {
        "model": "joulesmith:block/advanced_energy_cable_arm",
        "x": 270
      }
    },
    {
      "when": {
        "node": "false",
        "up": "true"
      },
      "apply": {
        "model": "joulesmith:block/advanced_energy_cable_half",
        "x": 270
      }
    },
    {
      "when": {
        "node": "true",
        "down": "true"
      },
      "apply": {
        "model": "joulesmith:block/advanced_energy_cable_arm",
        "x": 90
      }
    },
    {
      "when": {
        "node": "false",
        "down": "true"
      },
      "apply": {
        "model": "joulesmith:block/advanced_energy_cable_half",
        "x": 90
      }
    }
  ]
}
